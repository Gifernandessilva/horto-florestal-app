generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Congregation {
  id         String      @id @default(uuid())
  name       String
  city       String
  inviteCode String      @unique
  members    Member[]
  territory  Territory[]
  createdAt  DateTime    @default(now())
}

model Member {
  id              String          @id @default(uuid())
  name            String
  phone           String
  pin             String          @default("1234")
  role            String          @default("PUBLICADOR") // PUBLICADOR | PIONEIRO_AUXILIAR | PIONEIRO_REGULAR | ANCIAO | DESENVOLVEDOR | ADMIN
  monthlyGoal     Int             @default(0)
  yearlyGoal      Int             @default(0)
  canUseTimer     Boolean         @default(true)
  canViewAllHours Boolean         @default(false)
  canAssignParts  Boolean         @default(false)
  serviceGroup    String
  congregationId  String
  congregation    Congregation    @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  timeLogs        TimeLog[]
  monthlyReports  MonthlyReport[]
  assignments     Assignment[]
  createdAt       DateTime        @default(now())
}

model TimeLog {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date        String
  durationSec Int
  revisitas   Int      @default(0)
  estudos     Int      @default(0)
  syncedAt    DateTime @default(now())

  @@index([memberId])
}

model MonthlyReport {
  id           String   @id @default(uuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  monthYear    String
  participated Boolean  @default(true)
  totalHours   Float    @default(0)
  returnVisits Int      @default(0)
  bibleStudies Int      @default(0)
  notes        String?
  submittedAt  DateTime @default(now())

  @@unique([memberId, monthYear])
}

model Assignment {
  id       String @id @default(uuid())
  cargo    String
  data     String
  local    String @default("Salão Principal")
  status   String @default("pendente")
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model Territory {
  id             String       @id
  nome           String
  quadras        Int
  status         String
  responsavel    String
  lat            Float
  lng            Float
  congregationId String
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
}

model MidweekMeeting {
  id            String   @id @default(uuid())
  weekLabel     String
  chairman      String
  openingPrayer String
  closingPrayer String
  partsJson     String
  createdAt     DateTime @default(now())
}

model CleaningSchedule {
  id        String   @id @default(uuid())
  weekLabel String
  groupName String
  notes     String?
  createdAt DateTime @default(now())
}